{
  "problemMatcher": [
    {
      "owner": "dyerplay-msvc",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*([A-Za-z]:[^(]+|[^\\s(][^(]*)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?error\\s+([A-Z]+\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "dyerplay-link",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*([^\\s:][^:]*?)\\s*:\\s+(?:fatal\\s+)?error\\s+(LNK\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "code": 2,
          "message": 3
        }
      ]
    }
  ]
}
